{
  "functions": {
    "api/[...path].mjs": {
      "includeFiles": [
        "index.html",
        "admin.html",
        "assets/**",
        "images/**",
        "pages/**",
        "BrannEco_Catalogue.pdf"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].mjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}